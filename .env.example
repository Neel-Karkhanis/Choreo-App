# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets.

# Signs and verifies session cookies. Required — the server refuses to start
# without it (see src/api/auth.py). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Comma-separated list of origins the API will accept cross-origin requests
# and cookies from. In production, frontend and API are same-origin behind
# Caddy, so this rarely needs to include the public domain at all — it
# mainly matters for local dev, where the Vite dev server and the API run on
# different ports.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true only when the app is served over real HTTPS (production, behind
# Caddy). Leave false for local HTTP dev — a browser silently drops a Secure
# cookie sent over plain HTTP, which would otherwise look like login "not
# working" for no visible reason.
COOKIE_SECURE=false

# Where the RQ job queue and analysis-progress channel live. Defaults to a
# local Redis; docker-compose points this at the `redis` service instead.
REDIS_URL=redis://localhost:6379/0

# Per-account storage guardrails (bytes / track count). Defaults shown.
# CHOREO_MAX_STORAGE_BYTES=2147483648
# CHOREO_MAX_TRACKS=60

# The public domain Caddy requests a TLS certificate for. Only read by the
# `caddy` service (see Caddyfile) — irrelevant for local `venv`/`npm run dev`
# use, and only needed at all once you're running docker-compose. Set it to
# `localhost` for local docker-compose verification (Caddy serves plain HTTP,
# no ACME attempt, for a non-public host) and to your real domain in
# production.
DOMAIN=localhost
