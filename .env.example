# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets.

# Signs and verifies the anonymous device-id cookie. Required — the server
# refuses to start without it (see src/api/identity.py). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# THE MOST FRAGILE VALUE IN THIS SYSTEM. There are no accounts, so there is
# no password reset, no "forgot my login", no support-desk recovery path —
# a device's entire identity IS its signed cookie, and that signature is
# only ever valid against this exact secret. Rotate or lose this value and
# every device's cookie stops verifying at once: get_owner_id (identity.py)
# rejects it with a 400, indistinguishable from a forged one, and the
# device falls back to whatever its IndexedDB mirror still has (nothing,
# for anyone who hasn't installed the PWA and hit ITP eviction). That is a
# PERMANENT, UNRECOVERABLE loss of every user's data — not a lockout, not
# an inconvenience. Back this value up somewhere durable outside the .env
# file it lives in, and never regenerate it as a "just in case" gesture.
SESSION_SECRET=

# Comma-separated list of origins the API will accept cross-origin requests
# and cookies from. In production, frontend and API are same-origin behind
# Caddy, so this rarely needs to include the public domain at all — it
# mainly matters for local dev, where the Vite dev server and the API run on
# different ports.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true only when the app is served over real HTTPS (production, behind
# Caddy). Leave false for local HTTP dev — a browser silently drops a Secure
# cookie sent over plain HTTP, which would otherwise look like the device id
# "not sticking" for no visible reason.
COOKIE_SECURE=false

# Where the RQ job queue and analysis-progress channel live. Defaults to a
# local Redis; docker-compose points this at the `redis` service instead.
REDIS_URL=redis://localhost:6379/0

# Per-device storage guardrails (bytes / track count). Defaults shown.
# CHOREO_MAX_STORAGE_BYTES=2147483648
# CHOREO_MAX_TRACKS=60

# Hard cap on a single upload's size, in bytes — checked while reading the
# body, not just against the (spoofable) Content-Length header. Default is
# 500MB, generous enough for a real video import while still bounding what
# one anonymous, unauthenticated caller can make the server buffer in one
# request. See server.py's CHOREO_MAX_UPLOAD_BYTES / _read_upload_within_limit.
# CHOREO_MAX_UPLOAD_BYTES=524288000

# Per-IP (not per-device — see server.py's own comment on why) rate limits
# on the two expensive, now-unauthenticated endpoints: uploading a new
# track, and requesting analysis (which can trigger a multi-minute Demucs
# run on a cache miss). Values are slowapi/limits syntax ("N/minute",
# "N/hour", etc). Defaults shown.
# CHOREO_IMPORT_RATE_LIMIT=10/minute
# CHOREO_ANALYSIS_RATE_LIMIT=30/minute

# How many Demucs separation jobs run at once, cluster-wide — see
# docker-compose.yml's `worker` service, where this sets deploy.replicas
# (each RQ worker process runs exactly one job at a time; N replicas
# against the shared queue is what makes this the real concurrency cap,
# not just a number the app reads). Paired with that same service's
# OMP_NUM_THREADS/MKL_NUM_THREADS=2, which is what stops those N jobs from
# each grabbing every core and fighting over them. Default (2) is sized
# for a 4 vCPU / 8GB box: measured ~1.4GB peak RSS for one job on a real
# ~4-minute track (Demucs + beat_this + onsets), and a single job already
# saturates ~2 cores' worth of CPU on its own — 2 concurrent jobs is
# roughly where the box's CPU runs out before its memory does. Re-measure
# before raising this on different hardware; do not just guess a bigger
# number.
# CHOREO_MAX_CONCURRENT_JOBS=2

# Which pushed image tag docker-compose.yml's `image:` lines resolve to —
# a short git SHA for a real deploy (see docker-compose.yml's own top
# comment). Leave unset for local dev (`docker compose up --build`, which
# defaults to a harmless local-only `:local` tag); prod's .env must set
# this to a real tag that was actually pushed to
# ghcr.io/neel-karkhanis/choreo-app-{backend,caddy}, e.g.:
# IMAGE_TAG=78b4ce5

# The public domain Caddy requests a TLS certificate for. Only read by the
# `caddy` service (see Caddyfile) — irrelevant for local `venv`/`npm run dev`
# use, and only needed at all once you're running docker-compose. Set it to
# `localhost` for local docker-compose verification (Caddy serves plain HTTP,
# no ACME attempt, for a non-public host) and to your real domain in
# production.
DOMAIN=localhost
